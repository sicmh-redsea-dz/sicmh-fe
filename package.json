{
  "name": "medit",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:staging": "ng build --configuration production,staging",
    "deploy:staging": "npm run build:staging && firebase deploy --project sicmh-441423 --config firebase.staging.json --only hosting:sicmh-441423",
    "test:doctor-autocomplete": "node --test tests/doctor-autocomplete.test.cjs",
    "test:clinical-profile": "node --test tests/clinical-profile.test.mjs",
    "test:inventory-picker": "node --test tests/inventory-picker.test.mjs",
    "watch": "ng build --watch --configuration development",
    "test:patient-clinical-fields": "node --test tests/patient-clinical-fields.test.mjs",
    "test:session-drafts": "node --test tests/form-draft.test.mjs tests/auth-session.test.mjs tests/session-activity.test.mjs tests/clinical-profile.test.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/fire": "^18.0.1",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@fullcalendar/angular": "^6.1.17",
    "@fullcalendar/core": "^6.1.17",
    "@fullcalendar/daygrid": "^6.1.17",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "popper.js": "^1.16.1",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.14.0",
    "tippy.js": "^6.3.7",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.4",
    "@angular/cli": "^18.2.4",
    "@angular/compiler-cli": "^18.2.0",
    "@types/jasmine": "~5.1.0",
    "angular-cli-ghpages": "^2.0.3",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.2"
  }
